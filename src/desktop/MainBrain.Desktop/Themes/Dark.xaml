<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Matrix / neo-futuristic palette -->
  <Color x:Key="BgColor">#FF020608</Color>
  <Color x:Key="PanelColor">#CC03140F</Color>
  <Color x:Key="TaskbarColor">#E6020F0A</Color>
  <Color x:Key="AccentColor">#FF00FF88</Color>
  <Color x:Key="MutedColor">#FF4ADE80</Color>
  <Color x:Key="TextColor">#FFB7FFD0</Color>
  <Color x:Key="DangerColor">#FFFF3355</Color>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="TaskbarBrush" Color="{StaticResource TaskbarColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
  </Style>

  <Style x:Key="TaskBtn" TargetType="Button">
    <Setter Property="Background" Value="#2200FF88"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="BorderBrush" Value="#4400FF88"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#5500FF88"/>
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#00FF88" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource TaskBtn}">
    <Setter Property="Background" Value="#AA00AA55"/>
    <Setter Property="Foreground" Value="#FFE8FFE8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource TaskBtn}">
    <Setter Property="Background" Value="#AA880022"/>
    <Setter Property="BorderBrush" Value="#FFFF3355"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="#4400FF88"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="BorderBrush" Value="#6600FF88"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#22000000"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="#FF00FF88"/>
    <Setter Property="SelectionBrush" Value="#6600FF88"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</ResourceDictionary>
