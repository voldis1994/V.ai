<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cyber pink / neo-futuristic palette -->
  <Color x:Key="BgColor">#FF08020A</Color>
  <Color x:Key="PanelColor">#CC1A0314</Color>
  <Color x:Key="TaskbarColor">#E60F0210</Color>
  <Color x:Key="AccentColor">#FFFF2ECB</Color>
  <Color x:Key="MutedColor">#FFE879C8</Color>
  <Color x:Key="TextColor">#FFFFB7EC</Color>
  <Color x:Key="DangerColor">#FFFF3355</Color>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="TaskbarBrush" Color="{StaticResource TaskbarColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
  </Style>

  <Style x:Key="TaskBtn" TargetType="Button">
    <Setter Property="Background" Value="#22FF2ECB"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="BorderBrush" Value="#44FF2ECB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#55FF2ECB"/>
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#FF2ECB" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource TaskBtn}">
    <Setter Property="Background" Value="#AAFF2ECB"/>
    <Setter Property="Foreground" Value="#FFFFE8F8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource TaskBtn}">
    <Setter Property="Background" Value="#AA880022"/>
    <Setter Property="BorderBrush" Value="#FFFF3355"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="#44FF2ECB"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="BorderBrush" Value="#66FF2ECB"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#22000000"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="#FFFF2ECB"/>
    <Setter Property="SelectionBrush" Value="#66FF2ECB"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</ResourceDictionary>
