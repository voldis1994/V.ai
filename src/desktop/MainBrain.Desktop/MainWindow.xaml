<Window x:Class="MainBrain.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Title}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Thin top status -->
    <Border Grid.Row="0" Background="{StaticResource TaskbarBrush}" Padding="14,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Main Brain" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ActiveModel}" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ActiveJobs, StringFormat=Darbi: {0}}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Aģenti" Style="{StaticResource TaskBtn}" Command="{Binding ToggleAgentsCommand}"/>
          <Button Content="Inspektors" Style="{StaticResource TaskBtn}" Command="{Binding ToggleInspectorCommand}"/>
          <Button Content="Focus" Style="{StaticResource TaskBtn}" Command="{Binding SetFocusModeCommand}"/>
          <Button Content="Multi" Style="{StaticResource TaskBtn}" Command="{Binding SetMultiModeCommand}"/>
          <Button Content="STOP" Style="{StaticResource DangerBtn}" Command="{Binding EmergencyStopCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Row="1">
      <!-- Left agents drawer (hidden by default) -->
      <Border Width="300" HorizontalAlignment="Left" Background="{StaticResource PanelBrush}"
              Visibility="{Binding AgentsVisibility}" Padding="10" Panel.ZIndex="20">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="50 aģenti" FontWeight="Bold" Margin="0,0,0,8"/>
          <TextBox DockPanel.Dock="Top" Text="{Binding WorkspacePath}" Margin="0,0,0,8" ToolTip="Darba mape"/>
          <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock>
                    <Run Text="{Binding Number, StringFormat={}{0:00}.}" FontWeight="Bold"/>
                    <Run Text="{Binding Name}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Section}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Right inspector drawer -->
      <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource PanelBrush}"
              Visibility="{Binding InspectorVisibility}" Padding="10" Panel.ZIndex="20">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Inspektors" FontWeight="Bold" Margin="0,0,0,8"/>
          <Button DockPanel.Dock="Top" Content="Izsaukt aģentu" Style="{StaticResource AccentBtn}" Command="{Binding InvokeSelectedAgentCommand}" Margin="0,0,0,8"/>
          <TextBox Text="{Binding InspectorText}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto" Background="#0B1220" Foreground="White" BorderThickness="0"/>
        </DockPanel>
      </Border>

      <!-- FOCUS: one surface; empty until a program/panel is active -->
      <Grid Visibility="{Binding FocusVisibility}" Margin="0">
        <!-- Home = chat surface -->
        <Border Visibility="{Binding HomeVisibility}" Background="#0B1020" Padding="24">
          <DockPanel MaxWidth="900" HorizontalAlignment="Center">
            <TextBlock DockPanel.Dock="Top" Text="Saruna ar Main Brain" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Top" Text="Rakstiet brīvi — jautājumi, idejas, uzdevumi. Izpildei: «Izveido…» vai «Izpildi: …»"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <TextBox Text="{Binding ChatOutput}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" FontSize="15"/>
          </DockPanel>
        </Border>

        <Border Visibility="{Binding BrowserVisibility}" Background="#020617">
          <wv2:WebView2 x:Name="Browser" Source="about:blank"/>
        </Border>
        <Border Visibility="{Binding EditorVisibility}" Background="#020617" Padding="12">
          <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas" FontSize="14"
                   Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
        </Border>
        <Border Visibility="{Binding TerminalVisibility}" Background="#020617" Padding="12">
          <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                   Background="Transparent" Foreground="#86EFAC" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
        </Border>
        <Border Visibility="{Binding LiveVisibility}" Background="#020617" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Dzīvais attēls" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <Image x:Name="LiveImage" Stretch="Uniform"/>
          </DockPanel>
        </Border>
        <Border Visibility="{Binding LogVisibility}" Background="#020617" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Žurnāls / saruna" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding ChatOutput}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- MULTI -->
      <Grid Visibility="{Binding MultiVisibility}" Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Margin="0,0,4,4" Background="#020617">
          <wv2:WebView2 x:Name="BrowserMulti" Source="about:blank"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="0" Margin="4,0,0,4" Background="#020617" Padding="8">
          <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas"
                   Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"/>
        </Border>
        <Border Grid.Column="0" Grid.Row="1" Margin="0,4,4,0" Background="#020617" Padding="8">
          <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas"
                   Background="Transparent" Foreground="#86EFAC" BorderThickness="0"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Margin="4,4,0,0" Background="#020617" Padding="8">
          <ListBox ItemsSource="{Binding Panels}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#1E293B" Padding="10" Margin="4" CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>

    <!-- Bottom taskbar + command -->
    <Border Grid.Row="2" Background="{StaticResource TaskbarBrush}" Padding="10,8">
      <DockPanel>
        <!-- Approvals strip if any -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#331E293B" CornerRadius="8"
                Visibility="{Binding ApprovalsVisibility}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Atļaut" Style="{StaticResource AccentBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="allowed_once"/>
              <Button Content="Noraidīt" Style="{StaticResource DangerBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="rejected"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Approvals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Action}" Margin="0,0,12,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom">
          <!-- App taskbar -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Content="Sākums" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="home"/>
            <Button Content="Pārlūks" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="browser"/>
            <Button Content="Redaktors" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="editor"/>
            <Button Content="Terminālis" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="terminal"/>
            <Button Content="Dzīvais" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="live"/>
            <Button Content="Žurnāls" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="log"/>
            <Button Content="Fiksēt" Style="{StaticResource TaskBtn}" Command="{Binding ToggleFocusPinCommand}"/>
          </StackPanel>
          <!-- Chat input -->
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Sūtīt" Style="{StaticResource AccentBtn}"
                    Command="{Binding SendGoalCommand}" MinWidth="90"/>
            <TextBox x:Name="ChatBox" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="44" VerticalContentAlignment="Center" FontSize="15"
                     Background="#0B1220" Foreground="White" BorderBrush="#334155" BorderThickness="1"
                     Padding="14,10" ToolTip="Rakstiet ziņu… Enter = sūtīt"
                     KeyDown="ChatBox_OnKeyDown"/>
          </DockPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
