<Window x:Class="MainBrain.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ctrl="clr-namespace:MainBrain.Desktop.Controls"
        Title="{Binding Title}"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#08020A"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_OnKeyDown">
  <Grid>
    <!-- Dzīvā Matrix sistēma — hieroglifi salido atbildē -->
    <ctrl:MatrixMindCanvas x:Name="Mind"
                           Panel.ZIndex="0"
                           AnswerText="{Binding FormedAnswer}"
                           IsThinking="{Binding IsThinking}"
                           StatusLine="{Binding MatrixStatus}"/>

    <!-- Immersīvais režīms: VIENS ekrāns — Matrix + jautājums (bez paneļu pārslēgšanas) -->
    <DockPanel Panel.ZIndex="2" Visibility="{Binding ImmersiveVisibility}">
      <Border DockPanel.Dock="Bottom" Background="#AA08020A" Padding="24,10,24,18">
        <StackPanel MaxWidth="920" HorizontalAlignment="Center">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="▌" FontFamily="Consolas" FontSize="20"
                       Foreground="#FFFF2ECB" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock.Effect>
                <DropShadowEffect Color="#FF2ECB" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
              </TextBlock.Effect>
            </TextBlock>
            <TextBox x:Name="ChatBox" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="40" VerticalContentAlignment="Center" FontSize="16" FontFamily="Consolas"
                     Background="Transparent" Foreground="#FFFFB7EC" BorderThickness="0"
                     CaretBrush="#FFFF2ECB" Padding="0,8"
                     KeyDown="ChatBox_OnKeyDown"/>
          </DockPanel>
          <TextBlock Text="Enter · jautā   ·   Esc · atpakaļ no pārlūka   ·   Ctrl+Shift+D · sistēma   ·   F11 · logs"
                     FontFamily="Consolas" FontSize="11" Foreground="#44FF2ECB"
                     HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <!-- Kamera/attēls uz TĀ PAŠA Matrix ekrāna (nevis atsevišķs panelis) -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,12"
              Width="280" MaxHeight="200" CornerRadius="4"
              BorderBrush="#66FF2ECB" BorderThickness="1" Background="#8808020A"
              Visibility="{Binding ImmersiveLiveVisibility}">
        <Image x:Name="ImmersiveLiveImage" Stretch="Uniform" Opacity="0.92"/>
      </Border>
    </DockPanel>

    <!-- Dev chrome: tikai Ctrl+Shift+D (nav redzams parasti) -->
    <Grid Panel.ZIndex="3" Visibility="{Binding ChromeVisibility}">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#EE0A0210" BorderBrush="#44FF2ECB" BorderThickness="0,0,0,1" Padding="12,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="◈ DEV" FontWeight="Bold" Foreground="#FFFF2ECB" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveModel}" Margin="10,0,0,0" Foreground="#88FF2ECB" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AgentCountText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFFF7CE8"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Aģenti" Style="{StaticResource TaskBtn}" Command="{Binding ToggleAgentsCommand}"/>
            <Button Content="Inspektors" Style="{StaticResource TaskBtn}" Command="{Binding ToggleInspectorCommand}"/>
            <Button Content="Focus" Style="{StaticResource TaskBtn}" Command="{Binding SetFocusModeCommand}"/>
            <Button Content="Multi" Style="{StaticResource TaskBtn}" Command="{Binding SetMultiModeCommand}"/>
            <Button Content="Immersīvs" Style="{StaticResource AccentBtn}" Command="{Binding ToggleImmersiveCommand}"/>
            <Button Content="STOP" Style="{StaticResource DangerBtn}" Command="{Binding EmergencyStopCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Border Width="300" HorizontalAlignment="Left" Background="{StaticResource PanelBrush}"
                BorderBrush="#44FF2ECB" BorderThickness="0,0,1,0"
                Visibility="{Binding AgentsVisibility}" Padding="10" Panel.ZIndex="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="50 AGENTS" FontWeight="Bold" Foreground="#FFFF2ECB" Margin="0,0,0,8"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding WorkspacePath}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Foreground="#FFFFB7EC">
                      <Run Text="{Binding Number, StringFormat={}{0:00}.}" FontWeight="Bold"/>
                      <Run Text="{Binding Name}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Section}" Foreground="#88FF2ECB" FontSize="11"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource PanelBrush}"
                BorderBrush="#44FF2ECB" BorderThickness="1,0,0,0"
                Visibility="{Binding InspectorVisibility}" Padding="10" Panel.ZIndex="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INSPECT" FontWeight="Bold" Foreground="#FFFF2ECB" Margin="0,0,0,8"/>
            <Button DockPanel.Dock="Top" Content="Izsaukt aģentu" Style="{StaticResource AccentBtn}" Command="{Binding InvokeSelectedAgentCommand}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding InspectorText}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#FFFFB7EC" BorderThickness="0"/>
          </DockPanel>
        </Border>

        <Grid Visibility="{Binding FocusVisibility}" Margin="0,0,0,0">
          <Border Visibility="{Binding BrowserVisibility}" Background="#EE0A0210">
            <wv2:WebView2 x:Name="Browser" Source="about:blank"/>
          </Border>
          <Border Visibility="{Binding EditorVisibility}" Background="#CC0A0210" Padding="12">
            <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas" FontSize="14"
                     Background="Transparent" Foreground="#FFFFB7EC" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
          </Border>
          <Border Visibility="{Binding TerminalVisibility}" Background="#CC0A0210" Padding="12">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     Background="Transparent" Foreground="#FFFF2ECB" BorderThickness="0"/>
          </Border>
          <Border Visibility="{Binding LiveVisibility}" Background="#CC0A0210" Padding="8">
            <Image x:Name="LiveImage" Stretch="Uniform"/>
          </Border>
          <Border Visibility="{Binding LogVisibility}" Background="#CC0A0210" Padding="12">
            <ctrl:MatrixTypewriterBox FullText="{Binding ChatOutput}" FontSize="15"/>
          </Border>
        </Grid>

        <Grid Visibility="{Binding MultiVisibility}" Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Column="0" Grid.Row="0" Margin="0,0,4,4" Background="#EE0A0210" BorderBrush="#33FF2ECB" BorderThickness="1">
            <wv2:WebView2 x:Name="BrowserMulti" Source="about:blank"/>
          </Border>
          <Border Grid.Column="1" Grid.Row="0" Margin="4,0,0,4" Background="#CC0A0210" BorderBrush="#33FF2ECB" BorderThickness="1" Padding="8">
            <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas"
                     Background="Transparent" Foreground="#FFFFB7EC" BorderThickness="0"/>
          </Border>
          <Border Grid.Column="0" Grid.Row="1" Margin="0,4,4,0" Background="#CC0A0210" BorderBrush="#33FF2ECB" BorderThickness="1" Padding="8">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas"
                     Background="Transparent" Foreground="#FFFF2ECB" BorderThickness="0"/>
          </Border>
          <Border Grid.Column="1" Grid.Row="1" Margin="4,4,0,0" Background="#CC0A0210" BorderBrush="#33FF2ECB" BorderThickness="1" Padding="8">
            <ListBox ItemsSource="{Binding Panels}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#22FF2ECB" Padding="10" Margin="4" BorderBrush="#44FF2ECB" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FFFF2ECB"/>
                      <TextBlock Text="{Binding Status}" Foreground="#88FF2ECB"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#EE0A0210" BorderBrush="#44FF2ECB" BorderThickness="0,1,0,0" Padding="10,8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#22FF2ECB" BorderBrush="#44FF2ECB" BorderThickness="1"
                  Visibility="{Binding ApprovalsVisibility}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Atļaut" Style="{StaticResource AccentBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="allowed_once"/>
                <Button Content="Noraidīt" Style="{StaticResource DangerBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="rejected"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Approvals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Action}" Margin="0,0,12,0" Foreground="#FFFFB7EC"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Button Content="Sākums" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="home"/>
              <Button Content="Pārlūks" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="browser"/>
              <Button Content="Redaktors" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="editor"/>
              <Button Content="Terminālis" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="terminal"/>
              <Button Content="Dzīvais" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="live"/>
              <Button Content="Žurnāls" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="log"/>
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="▶ SŪTĪT" Style="{StaticResource AccentBtn}"
                      Command="{Binding SendGoalCommand}" MinWidth="100"/>
              <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="40" VerticalContentAlignment="Center" FontSize="14" FontFamily="Consolas"
                       Background="#AA0A0210" Foreground="#FFFFB7EC" BorderBrush="#66FF2ECB" BorderThickness="1"
                       Padding="12,8" KeyDown="ChatBox_OnKeyDown"/>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
