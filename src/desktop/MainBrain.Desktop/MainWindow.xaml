<Window x:Class="MainBrain.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Title}"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
  <DockPanel>
    <!-- Augšējā josla -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Main Brain OS" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding ActiveModel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding ResourceText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Lokāli aktīvs"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Text" Value="Bezsaistē"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding ActiveJobs, StringFormat=Aktīvie darbi: {0}}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Pauze" Command="{Binding PauseCommand}"/>
          <Button Content="Turpināt" Command="{Binding ResumeCommand}"/>
          <Button Content="STOP" Command="{Binding EmergencyStopCommand}" Background="{StaticResource DangerBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Apakšējais čats / terminālis -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="8" Height="220">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl>
          <TabItem Header="Saruna">
            <TextBox Text="{Binding ChatOutput}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="White"/>
          </TabItem>
          <TabItem Header="Terminālis">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas"
                     Background="#020617" Foreground="#86EFAC"/>
          </TabItem>
          <TabItem Header="Apstiprinājumi">
            <ListBox ItemsSource="{Binding Approvals}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Action}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Impact}" Opacity="0.8"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="Sūtīt" Command="{Binding SendGoalCommand}"/>
          <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="36" VerticalContentAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Kreisā navigācija -->
    <Border DockPanel.Dock="Left" Width="280" Background="{StaticResource PanelBrush}" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Navigācija" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="Darba mape:" Margin="0,0,0,4"/>
        <TextBox DockPanel.Dock="Top" Text="{Binding WorkspacePath}" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="50 aģenti" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}">
          <ListBox.GroupStyle>
            <GroupStyle/>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock>
                  <Run Text="{Binding Number, StringFormat={}{0:00}.}" FontWeight="Bold"/>
                  <Run Text="{Binding Name}"/>
                </TextBlock>
                <TextBlock Text="{Binding Section}" Opacity="0.7" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Labais inspektors -->
    <Border DockPanel.Dock="Right" Width="320" Background="{StaticResource PanelBrush}" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Inspektors" FontWeight="Bold" Margin="0,0,0,8"/>
        <Button DockPanel.Dock="Top" Content="Izsaukt aģentu" Command="{Binding InvokeSelectedAgentCommand}"/>
        <TextBox Text="{Binding InspectorText}" AcceptsReturn="True" TextWrapping="Wrap"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="White"/>
      </DockPanel>
    </Border>

    <!-- Centrālā darba zona -->
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Fokusa režīms" Command="{Binding ToggleModeCommand}"/>
        <Button Content="Vairāku logu režīms" Command="{Binding ToggleModeCommand}"/>
        <TextBlock Text="{Binding CurrentPanelKind}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Iegultais pārlūks -->
        <Border Grid.Column="0" Grid.Row="0" Margin="0,0,4,4" Background="#020617" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Iegultais pārlūks (WebView2)" Margin="0,0,0,4"/>
            <wv2:WebView2 x:Name="Browser" Source="https://example.com"/>
          </DockPanel>
        </Border>

        <!-- Redaktors / žurnāls -->
        <Border Grid.Column="1" Grid.Row="0" Margin="4,0,0,4" Background="#020617" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Redaktors / Dzīvais attēls / Nav pieejams" Margin="0,0,0,4"/>
            <TextBox AcceptsReturn="True" FontFamily="Consolas" Background="#0B1220" Foreground="#E2E8F0"
                     Text="# Main Brain OS redaktors&#x0a;# Paneļu tipi: Dzīvais attēls | Iegultais pārlūks | Redaktors | Terminālis | Žurnāls | Nav pieejams"/>
          </DockPanel>
        </Border>

        <!-- Paneļu režīms -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="#020617" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Paneļi (dokojami / cilnes)" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding Panels}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#1E293B" Padding="10" Margin="4" Width="180">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Kind}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
