<Window x:Class="MainBrain.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ctrl="clr-namespace:MainBrain.Desktop.Controls"
        Title="{Binding Title}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#020608"
        Foreground="{StaticResource TextBrush}">
  <Grid>
    <!-- MATRIX LAYER (full window) -->
    <ctrl:MatrixRainCanvas x:Name="MatrixBg" Panel.ZIndex="0"/>

    <Grid Panel.ZIndex="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Top HUD -->
      <Border Grid.Row="0" Background="{StaticResource TaskbarBrush}" BorderBrush="#4400FF88" BorderThickness="0,0,0,1" Padding="14,0">
        <Border.Effect>
          <DropShadowEffect Color="#00FF88" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="◈ MAIN BRAIN" FontWeight="Bold" FontSize="15" Foreground="#FF00FF88" VerticalAlignment="Center">
              <TextBlock.Effect>
                <DropShadowEffect Color="#00FF88" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
              </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveModel}" Margin="12,0,0,0" Foreground="#8800FF88" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveJobs, StringFormat=JOBS:{0}}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AgentCountText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF7CFFB2"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Aģenti" Style="{StaticResource TaskBtn}" Command="{Binding ToggleAgentsCommand}"/>
            <Button Content="Inspektors" Style="{StaticResource TaskBtn}" Command="{Binding ToggleInspectorCommand}"/>
            <Button Content="Focus" Style="{StaticResource TaskBtn}" Command="{Binding SetFocusModeCommand}"/>
            <Button Content="Multi" Style="{StaticResource TaskBtn}" Command="{Binding SetMultiModeCommand}"/>
            <Button Content="STOP" Style="{StaticResource DangerBtn}" Command="{Binding EmergencyStopCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Workspace -->
      <Grid Grid.Row="1">
        <Border Width="300" HorizontalAlignment="Left" Background="{StaticResource PanelBrush}"
                BorderBrush="#4400FF88" BorderThickness="0,0,1,0"
                Visibility="{Binding AgentsVisibility}" Padding="10" Panel.ZIndex="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="50 AGENTS" FontWeight="Bold" Foreground="#FF00FF88" Margin="0,0,0,8"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding WorkspacePath}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Foreground="#FFB7FFD0">
                      <Run Text="{Binding Number, StringFormat={}{0:00}.}" FontWeight="Bold"/>
                      <Run Text="{Binding Name}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Section}" Foreground="#8800FF88" FontSize="11"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource PanelBrush}"
                BorderBrush="#4400FF88" BorderThickness="1,0,0,0"
                Visibility="{Binding InspectorVisibility}" Padding="10" Panel.ZIndex="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INSPECT" FontWeight="Bold" Foreground="#FF00FF88" Margin="0,0,0,8"/>
            <Button DockPanel.Dock="Top" Content="Izsaukt aģentu" Style="{StaticResource AccentBtn}" Command="{Binding InvokeSelectedAgentCommand}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding InspectorText}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#FFB7FFD0" BorderThickness="0"/>
          </DockPanel>
        </Border>

        <Grid Visibility="{Binding FocusVisibility}">
          <!-- MATRIX CHAT -->
          <Border Visibility="{Binding HomeVisibility}" Background="#66010406" Padding="28">
            <Border BorderBrush="#3300FF88" BorderThickness="1" Padding="18" MaxWidth="960" HorizontalAlignment="Center">
              <Border.Effect>
                <DropShadowEffect Color="#00FF88" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
              </Border.Effect>
              <ctrl:MatrixTypewriterBox FullText="{Binding ChatOutput}" FontSize="17"/>
            </Border>
          </Border>

          <Border Visibility="{Binding BrowserVisibility}" Background="#EE020608">
            <wv2:WebView2 x:Name="Browser" Source="about:blank"/>
          </Border>
          <Border Visibility="{Binding EditorVisibility}" Background="#CC020608" Padding="12">
            <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas" FontSize="14"
                     Background="Transparent" Foreground="#FFB7FFD0" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
          </Border>
          <Border Visibility="{Binding TerminalVisibility}" Background="#CC020608" Padding="12">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     Background="Transparent" Foreground="#FF00FF88" BorderThickness="0"/>
          </Border>
          <Border Visibility="{Binding LiveVisibility}" Background="#CC020608" Padding="8">
            <Image x:Name="LiveImage" Stretch="Uniform"/>
          </Border>
          <Border Visibility="{Binding LogVisibility}" Background="#CC020608" Padding="12">
            <ctrl:MatrixTypewriterBox FullText="{Binding ChatOutput}" FontSize="15"/>
          </Border>
        </Grid>

        <Grid Visibility="{Binding MultiVisibility}" Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Column="0" Grid.Row="0" Margin="0,0,4,4" Background="#EE020608" BorderBrush="#3300FF88" BorderThickness="1">
            <wv2:WebView2 x:Name="BrowserMulti" Source="about:blank"/>
          </Border>
          <Border Grid.Column="1" Grid.Row="0" Margin="4,0,0,4" Background="#CC020608" BorderBrush="#3300FF88" BorderThickness="1" Padding="8">
            <TextBox Text="{Binding EditorText}" AcceptsReturn="True" FontFamily="Consolas"
                     Background="Transparent" Foreground="#FFB7FFD0" BorderThickness="0"/>
          </Border>
          <Border Grid.Column="0" Grid.Row="1" Margin="0,4,4,0" Background="#CC020608" BorderBrush="#3300FF88" BorderThickness="1" Padding="8">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" FontFamily="Consolas"
                     Background="Transparent" Foreground="#FF00FF88" BorderThickness="0"/>
          </Border>
          <Border Grid.Column="1" Grid.Row="1" Margin="4,4,0,0" Background="#CC020608" BorderBrush="#3300FF88" BorderThickness="1" Padding="8">
            <ListBox ItemsSource="{Binding Panels}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#2200FF88" Padding="10" Margin="4" BorderBrush="#4400FF88" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FF00FF88"/>
                      <TextBlock Text="{Binding Status}" Foreground="#8800FF88"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Grid>

      <!-- Bottom console -->
      <Border Grid.Row="2" Background="{StaticResource TaskbarBrush}" BorderBrush="#4400FF88" BorderThickness="0,1,0,0" Padding="10,8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#2200FF88" BorderBrush="#4400FF88" BorderThickness="1"
                  Visibility="{Binding ApprovalsVisibility}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Atļaut" Style="{StaticResource AccentBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="allowed_once"/>
                <Button Content="Noraidīt" Style="{StaticResource DangerBtn}" Command="{Binding DecideApprovalCommand}" CommandParameter="rejected"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Approvals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Action}" Margin="0,0,12,0" Foreground="#FFB7FFD0"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Button Content="Sākums" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="home"/>
              <Button Content="Pārlūks" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="browser"/>
              <Button Content="Redaktors" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="editor"/>
              <Button Content="Terminālis" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="terminal"/>
              <Button Content="Dzīvais" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="live"/>
              <Button Content="Žurnāls" Style="{StaticResource TaskBtn}" Command="{Binding SelectFocusSourceCommand}" CommandParameter="log"/>
              <Button Content="Fiksēt" Style="{StaticResource TaskBtn}" Command="{Binding ToggleFocusPinCommand}"/>
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="▶ SŪTĪT" Style="{StaticResource AccentBtn}"
                      Command="{Binding SendGoalCommand}" MinWidth="100"/>
              <TextBox x:Name="ChatBox" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="46" VerticalContentAlignment="Center" FontSize="15" FontFamily="Consolas"
                       Background="#AA020608" Foreground="#FFB7FFD0" BorderBrush="#6600FF88" BorderThickness="1"
                       Padding="14,10" KeyDown="ChatBox_OnKeyDown"/>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
